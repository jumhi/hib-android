<?xml version="1.0" encoding="utf-8"?>
<!-- H.I.B Flick widget: the latest photos, videos and screenshots; tap one to flick it, Select to flick a bundle. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flick_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_flick_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <ImageView
                android:id="@+id/flick_widget_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_flick_24"
                android:tint="@color/hib_flick_cyan" />

            <TextView
                android:id="@+id/flick_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Flick"
                android:textColor="@color/hib_flick_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/flick_widget_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/hib_flick_text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/flick_widget_select"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/widget_flick_pill"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Select"
                android:textColor="@color/hib_flick_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/flick_widget_more"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Pick photos"
                android:padding="5dp"
                android:src="@drawable/rounded_add_24"
                android:tint="@color/hib_flick_text" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/flick_widget_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

