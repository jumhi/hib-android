<?xml version="1.0" encoding="utf-8"?>
<!-- H.I.B widget. Generated layout: keep ids in sync with the provider. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hib_widget_clip"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/hw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/hib_widget_bg" />

    <LinearLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/hib_widget_padding">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_device_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="Computer"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/macbook_pro_gen3"
                android:tint="@color/hib_widget_accent" />

            <LinearLayout
                android:id="@+id/widget_battery_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="@drawable/hib_widget_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/outline_battery_full_24"
                    android:tint="@color/hib_widget_on_container" />

                <TextView
            android:id="@+id/widget_battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="82%"
            android:textColor="@color/hib_widget_on_container"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
            android:id="@+id/widget_tap_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Tap to reconnect"
            android:textColor="@color/hib_widget_on_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_gravity="center" android:background="@drawable/hib_widget_pill_accent" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hib_widget_dot"
                android:tint="@color/hib_widget_dot_in_use" />

            <TextView
            android:id="@+id/widget_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="MacBook Pro"
            android:textColor="@color/hib_widget_on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_secondary_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="In use · Mac"
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
             />

        <TextView
            android:id="@+id/widget_media_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="♪ Midnight City — M83"
            android:textColor="@color/hib_widget_accent"
            android:textSize="12sp"
            android:visibility="visible"
             />
    </LinearLayout>
</FrameLayout>
