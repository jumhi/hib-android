<?xml version="1.0" encoding="utf-8"?>
<!-- H.I.B widget. Generated layout: keep ids in sync with the provider. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hib_widget_clip"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/hw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/hib_widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/hw_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hib_wic_clipboard"
                android:tint="@color/hib_widget_accent" />

            <TextView
            android:id="@+id/hw_header_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Clipboard → MacBook Pro"
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hw_buttons"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/hw_send"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/hib_widget_tile_accent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hib_wic_send"
                    android:tint="@color/hib_widget_on_accent" />

                <TextView
            android:id="@+id/hw_send_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Send"
            android:textColor="@color/hib_widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hw_get"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/hib_widget_tile"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hib_wic_get"
                    android:tint="@color/hib_widget_on_container" />

                <TextView
            android:id="@+id/hw_get_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Get"
            android:textColor="@color/hib_widget_on_container"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hw_last"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:visibility="visible">

            <TextView
            android:id="@+id/hw_last_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="From Office PC · 2 min ago"
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="11sp"
             />

            <TextView
            android:id="@+id/hw_last_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="https://example.com/the-link-you-copied"
            android:textColor="@color/hib_widget_on_surface"
            android:textSize="13sp"
             />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
