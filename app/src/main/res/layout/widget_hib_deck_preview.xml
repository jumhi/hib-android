<?xml version="1.0" encoding="utf-8"?>
<!-- H.I.B widget. Generated layout: keep ids in sync with the provider. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hib_widget_clip"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/hw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/hib_widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/hw_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hib_wic_deck"
                android:tint="@color/hib_widget_accent" />

            <TextView
            android:id="@+id/hw_header_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Desk Deck → MacBook Pro"
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />

            <ImageView
                android:id="@+id/hw_configure"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/hib_widget_row"
                android:contentDescription="Choose buttons"
                android:padding="5dp"
                android:src="@drawable/rounded_settings_24"
                android:tint="@color/hib_widget_on_surface_variant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/hw_deck0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/hib_widget_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/hw_deck0_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hib_wic_lock"
                    android:tint="@color/hib_widget_on_container" />

                <TextView
            android:id="@+id/hw_deck0_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Lock"
            android:textColor="@color/hib_widget_on_container"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hw_deck1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/hib_widget_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/hw_deck1_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hib_wic_play"
                    android:tint="@color/hib_widget_on_container" />

                <TextView
            android:id="@+id/hw_deck1_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Play/Pause"
            android:textColor="@color/hib_widget_on_container"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/hw_deck2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/hib_widget_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/hw_deck2_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hib_wic_vol_down"
                    android:tint="@color/hib_widget_on_container" />

                <TextView
            android:id="@+id/hw_deck2_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Volume −"
            android:textColor="@color/hib_widget_on_container"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hw_deck3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/hib_widget_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/hw_deck3_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hib_wic_vol_up"
                    android:tint="@color/hib_widget_on_container" />

                <TextView
            android:id="@+id/hw_deck3_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Volume +"
            android:textColor="@color/hib_widget_on_container"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
