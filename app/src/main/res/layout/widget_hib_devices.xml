                android:background="@drawable/hib_widget_dot_ring"
                android:importantForAccessibility="no"
                android:padding="2dp"
                android:src="@drawable/hib_widget_dot"
                android:tint="@color/hib_widget_dot_off"
                android:visibility="visible" />
        </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
            android:id="@+id/hw_row1_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
             />

                <TextView
            android:id="@+id/hw_row1_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
             />
            </LinearLayout>

            <TextView
            android:id="@+id/hw_row1_batt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/hw_row2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/hib_widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/hw_row2_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/hib_widget_circle" />

            <ImageView
                android:id="@+id/hw_row2_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/hib_wic_laptop"
                android:tint="@color/hib_widget_on_container" />
            <ImageView
                android:id="@+id/hw_row2_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/hib_widget_dot_ring"
                android:importantForAccessibility="no"
                android:padding="2dp"
                android:src="@drawable/hib_widget_dot"
                android:tint="@color/hib_widget_dot_off"
                android:visibility="visible" />
        </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
            android:id="@+id/hw_row2_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
             />

                <TextView
            android:id="@+id/hw_row2_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
             />
            </LinearLayout>

            <TextView
            android:id="@+id/hw_row2_batt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/hw_row3"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/hib_widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/hw_row3_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/hib_widget_circle" />

            <ImageView
                android:id="@+id/hw_row3_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/hib_wic_laptop"
                android:tint="@color/hib_widget_on_container" />
            <ImageView
                android:id="@+id/hw_row3_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/hib_widget_dot_ring"
                android:importantForAccessibility="no"
                android:padding="2dp"
                android:src="@drawable/hib_widget_dot"
                android:tint="@color/hib_widget_dot_off"
                android:visibility="visible" />
        </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
            android:id="@+id/hw_row3_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
             />

                <TextView
            android:id="@+id/hw_row3_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
             />
            </LinearLayout>

            <TextView
            android:id="@+id/hw_row3_batt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hw_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
            android:visibility="gone"
            android:paddingStart="8dp" android:paddingTop="2dp" />

        <TextView
            android:id="@+id/hw_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="No computers yet — open H.I.B to add one"
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="13sp"
            android:visibility="gone"
            android:paddingStart="6dp" android:paddingTop="8dp" />
    </LinearLayout>
</FrameLayout>
