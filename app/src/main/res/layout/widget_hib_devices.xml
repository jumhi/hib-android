<?xml version="1.0" encoding="utf-8"?>
<!-- H.I.B widget. Generated layout: keep ids in sync with the provider. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hib_widget_clip"
    android:clipToOutline="true"
    tools:ignore="UseAppTint,UnusedAttribute,HardcodedText,NestedWeights,DisableBaselineAlignment,UseCompoundDrawables,RtlSymmetry">
    <!-- android:tint is right here: widgets are drawn by the launcher, without AppCompat. -->

    <ImageView
        android:id="@+id/hw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/hib_widget_bg" />

    <LinearLayout
        android:id="@+id/hw_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/hib_widget_padding">

        <LinearLayout
            android:id="@+id/hw_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView
            android:id="@+id/hw_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Your devices"
            android:textColor="@color/hib_widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold"
             />

            <TextView
            android:id="@+id/hw_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hw_row0"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/hib_widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/hw_row0_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/hib_widget_circle" />

            <ImageView
                android:id="@+id/hw_row0_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/hib_wic_laptop"
                android:tint="@color/hib_widget_on_container" />
            <ImageView
                android:id="@+id/hw_row0_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/hib_widget_dot_ring"
                android:importantForAccessibility="no"
                android:padding="2dp"
                android:src="@drawable/hib_widget_dot"
                android:tint="@color/hib_widget_dot_off"
                android:visibility="visible" />
        </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
            android:id="@+id/hw_row0_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
             />

                <TextView
            android:id="@+id/hw_row0_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
             />
            </LinearLayout>

            <TextView
            android:id="@+id/hw_row0_batt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/hib_widget_on_surface_variant"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/hw_row1"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/hib_widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

